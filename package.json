{
  "name": "lloyd-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "gh-pages": "^5.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^5.2.0",
    "styled-components": "^6.3.8"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.8.0",
    "vite": "^6.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
